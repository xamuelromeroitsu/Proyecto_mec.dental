# =========================================================================
# DENTALCONNECT v2 — Variables de entorno
# Copia este archivo como ".env" y completa con las claves de tu proyecto
# Supabase (Settings → API). NO subas el .env real a git (ya está ignorado).
# =========================================================================

# URL del proyecto Supabase (backend único de la agencia)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública anon — va al front; RLS define qué datos ve cada usuario
VITE_SUPABASE_ANON_KEY=TU_CLAVE_ANON

# Clave SECRETA — SOLO para Edge Functions/backend. NUNCA la subas al front.
SUPABASE_SERVICE_ROLE_KEY=TU_CLAVE_SERVICE_ROLE
